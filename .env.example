# Phase 1 runs fully local and free. No API keys are needed.
# Where the local Postgres (PGlite) data and uploaded/generated files are stored.
DATA_DIR=.data
# Only "mock" exists in Phase 1. Real providers are added later, one by one, after approval.
PROVIDERS_MODE=mock

# ---- Real providers (paid; enable only after approval) ----
# PROVIDERS_MODE=live
# fal.ai — images (Seedream 4, $0.03/image), video: Wan 2.2 ($0.04–0.08/s) and cinematic Kling 2.5 Turbo Pro ($0.07/s, 1080p)
# FAL_KEY=
# Speko — real Arabic voices (ElevenLabs v3), one fixed Voice ID per character
# SPEKO_API_KEY=
